{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "icon": {
      "type": "enumeration",
      "enum": ["code", "server", "rocket"],
      "required": true,
      "unique": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "shared.paragraph",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "order": {
      "type": "integer",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
